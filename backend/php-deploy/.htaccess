# Persat Finance API — Apache (LyteHosting cPanel)
# Document root = this folder (php-deploy/)

Options -Indexes
RewriteEngine On

# Pass Authorization header through to PHP (required for Bearer sessions)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Don't rewrite real files/dirs
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else → front controller
RewriteRule ^ index.php [L,QSA]

# Security headers (API)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer"
  Header set X-Frame-Options "DENY"
</IfModule>

# Block direct access to config secrets
<FilesMatch "^(config\.local\.php|config\.example\.php)$">
  Require all denied
</FilesMatch>

# PHP settings hints (cPanel may override)
<IfModule mod_php.c>
  php_value display_errors 0
</IfModule>
