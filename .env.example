# Persat Finance — configure real values only in your secure deployment environment.
# Never commit keypairs, secret keys, deployment tokens, or database credentials.

# Solana and signing (required before deployment)
# Cluster is devnet for the MVP. Solana testnet is for validator operators and
# has no Pyth receiver deployed; see contracts/config/devnet.json.
SOLANA_CLUSTER=devnet
# Public devnet RPC is rate-limited. Provision a dedicated Helius/QuickNode/
# Triton endpoint before running the indexer or keeper continuously.
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_DEPLOYER_KEYPAIR_PATH=
GOVERNANCE_SIGNER_1_PUBKEY=
GOVERNANCE_SIGNER_2_PUBKEY=
GOVERNANCE_SIGNER_3_PUBKEY=
KEEPER_KEYPAIR_PATH=
# No ORACLE_PUSHER key is needed. Pyth is a pull oracle: clients post signed
# Hermes updates themselves, so the protocol holds no price-pushing key.

# Bridge integration (only if required by the approved SDK/partner integration)
ZEUS_API_KEY=
THRESHOLD_API_KEY=

# Backend notifications and administration
SENDGRID_API_KEY=
ADMIN_API_KEY=

# Deployment
NEXT_PUBLIC_APP_URL=
DEPLOYMENT_TOKEN=
DOMAIN_DNS_TOKEN=

# Persistent backend state (required before enabling deal-link/proposal write APIs)
PERSAT_DATABASE_URL=
