name: Verify Solana protocol

on:
  push:
    branches:
      - main
      - "arena/**"
    paths:
      - "contracts/**"
      - ".github/workflows/protocol.yml"
  pull_request:
    paths:
      - "contracts/**"
      - ".github/workflows/protocol.yml"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: protocol-${{ github.ref }}
  cancel-in-progress: true

jobs:
  protocol:
    name: Anchor build and test
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: contracts

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: contracts/package-lock.json

      - name: Install Rust
        uses: dtolnay/rust-toolchain@stable

      - name: Cache Cargo
        uses: Swatinem/rust-cache@v2
        with:
          workspaces: contracts
          cache-on-failure: true

      - name: Install Solana CLI
        run: |
          sh -c "$(curl -sSfL https://release.anza.xyz/v3.1.10/install)"
          echo "$HOME/.local/share/solana/install/active_release/bin" >> "$GITHUB_PATH"

      - name: Report Solana CLI version
        run: solana --version

      - name: Install Anchor Version Manager
        run: |
          cargo install --git https://github.com/solana-foundation/anchor avm --locked
          avm install 1.0.2
          avm use 1.0.2
          anchor --version

      - name: Install protocol JavaScript dependencies
        run: |
          if [ -f package-lock.json ]; then
            npm ci
          fi

      # The SBF build must come first: the LiteSVM integration tests load
      # target/deploy/*.so, and skip themselves if it is absent. With the old
      # ordering they silently reported "0 passed" and proved nothing.
      - name: Build Anchor workspace
        run: anchor build --ignore-keys

      # Unit tests, fuzz properties, and LiteSVM access-control tests.
      # PERSAT_REQUIRE_PROGRAMS turns a missing .so into a hard failure so the
      # integration tests can never silently no-op in CI again.
      - name: Run unit, fuzz, and integration tests
        env:
          PERSAT_REQUIRE_PROGRAMS: "1"
        run: cargo test --workspace
