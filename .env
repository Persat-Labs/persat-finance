# Persat Finance — configure real values only in secure deployment env. Never commit secrets.
# Hybrid: PHP/MySQL for CRUD (cheap cPanel) + Node.js sidecar for Solana tx (auto-faucet, keeper, oracle, bridge health)
# See docs/php-mysql-backend-blueprint.md and backend/README.md

# Solana cluster — devnet for MVP (Solana testnet has no Pyth receiver)
SOLANA_CLUSTER=devnet
# Public devnet RPC is rate-limited (100 req/10s). Provision Helius/QuickNode for prod.
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_BACKEND_URL=https://api.persat.finance
NEXT_PUBLIC_APP_URL=https://persat.finance

# Deployer and governance — keypairs in secret manager, only pubkeys in repo
# For auto-faucet one-click (no bundle upload): set PERSAT_DEPLOYER_KEYPAIR as JSON array [64 numbers] — mint authority for stand-in mints 79AL..., DqQ1..., FsSP..., 8zdn...
PERSAT_DEPLOYER_KEYPAIR= [\n  49,\n  154,\n  247,\n  123,\n  41,\n  140,\n  225,\n  73,\n  224,\n  168,\n  234,\n  18,\n  91,\n  72,\n  48,\n  75,\n  171,\n  61,\n  89,\n  59,\n  248,\n  117,\n  255,\n  1,\n  54,\n  231,\n  248,\n  219,\n  86,\n  164,\n  70,\n  206,\n  207,\n  61,\n  153,\n  187,\n  27,\n  237,\n  34,\n  22,\n  43,\n  124,\n  158,\n  100,\n  127,\n  114,\n  132,\n  144,\n  169,\n  23,\n  48,\n  96,\n  172,\n  21,\n  163,\n  233,\n  138,\n  95,\n  175,\n  254,\n  237,\n  122,\n  69,\n  215\n]
SOLANA_DEPLOYER_KEYPAIR_PATH=
GOVERNANCE_SIGNER_1_PUBKEY=99QGZmjKBsm9Bcnw21jn61Qe9SLAKS5ZAFoKLZDu3aAD
GOVERNANCE_SIGNER_2_PUBKEY=9Az4yhFKRoGhCiJLY5ubS3ybLL9F4hvgKj4SQSnbURv2
GOVERNANCE_SIGNER_3_PUBKEY=F4rJY7TBP3eG381MTm5SwzehwPKYG5XA8T2etMD67Mki
KEEPER_KEYPAIR_PATH=
KEEPER_ENABLED=false
KEEPER_POLL_SECONDS=60

# Pyth pull oracle — no pusher key needed
PYTH_HERMES_URL=https://hermes.pyth.network
BTC_USD_FEED_ID=0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43

# Bridge integration — optional, health degrades to manual if missing
ZEUS_API_KEY=
THRESHOLD_API_KEY=

# Backend — Hybrid MySQL first, PG fallback (see backend/src/database.ts)
PORT=4000
NODE_ENV=development
# MySQL recommended for cheap hosting (cPanel): mysql://user:pass@host:3306/persat_finance
# OR Postgres (Supabase): postgresql://postgres:[HYQ+$?C.7DJjnb$]@db.xxkltphxzhbegopvltmh.supabase.co:5432/postgres
PERSAT_DATABASE_URL=mysql://user:pass@host:3306/persat_finance
# For PHP MySQL (cPanel): also set DB_HOST, DB_NAME, DB_USER, DB_PASS in backend/public/config.php
DB_HOST=127.0.0.1
DB_NAME=persat_finance
DB_USER=db_user
DB_PASS=db_password

ADMIN_API_KEY=
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGINS=https://persat.finance,https://app.persat.finance,https://3000-*.e2b.app
LOG_LEVEL=info
PG_POOL_MAX=20
PG_POOL_MIN=2

# Notifications
SENDGRID_API_KEY=

# Deployment tokens
DEPLOYMENT_TOKEN=
DOMAIN_DNS_TOKEN=
